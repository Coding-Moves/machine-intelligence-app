# Public canonical URL for metadata and auth redirects.
NEXT_PUBLIC_SITE_URL=
# Supabase project URL.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon/publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service-role key; server only.
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret for GitHub Actions API calls.
CRON_SECRET=
# Gemini API key used by the story writer and magazine layout builder.
GEMINI_API_KEY=
# Optional model override for story writing and editor notes.
WRITER_MODEL=
# Optional model override for magazine story placement.
DESIGNER_MODEL=
# Legacy token; current PDF compilation uses temporary signed storage URLs.
GITHUB_DISPATCH_TOKEN=
# App URL used by GitHub Actions; also add as the APP_URL repository secret.
APP_URL=
