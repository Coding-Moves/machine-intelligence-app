# Public canonical URL for metadata and auth redirects.
NEXT_PUBLIC_SITE_URL=
# Supabase project URL.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon/publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service-role key; server only.
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret for GitHub Actions API calls.
CRON_SECRET=
# Reserved for the later AI phase; unused by the foundation.
GEMINI_API_KEY=
# Reserved model name for the later writing phase.
WRITER_MODEL=
# Reserved model name for the later design phase.
DESIGNER_MODEL=
# Reserved for later workflow dispatch; unused by the foundation.
GITHUB_DISPATCH_TOKEN=
# App URL used by GitHub Actions; also add as the APP_URL repository secret.
APP_URL=
